{
  "name": "@tanzlate/root",
  "description": "",
  "version": "1.0.0",
  "author": "",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build-packages": "pnpm build --filter './packages/**'",
    "build-core": "pnpm --filter=@tanzlate/core build",
    "build-vanilla": "pnpm --filter=@tanzlate/vanilla build",
    "build-vue": "pnpm --filter=@tanzlate/vue build",
    "changeset": "changeset",
    "changeset:publish": "changeset publish",
    "changeset:snapshot": "changeset version --snapshot && changeset publish --tag snapshot",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "dev": "pnpm --filter=@tanzlate/nuxt-example dev",
    "dev:build": "pnpm --filter=nuxt-example build",
    "dev:build:vue": "pnpm --filter=@tanzlate/vue build",
    "dev:generate": "pnpm --filter=nuxt-example generate",
    "docs:build": "pnpm --filter docs docs:build",
    "docs:dev": "pnpm --filter docs docs:dev",
    "docs:preview": "pnpm --filter docs docs:preview",
    "app:nuxt": "PORT=3003 pnpm --filter=@tanzlate/nuxt-example dev",
    "format": "prettier --write .",
    "lint": "eslint .",
    "prepare": "husky",
    "preview": "pnpm --filter @tanzlate/vanilla preview",
    "preview:vue": "pnpm --filter=@tanzlate/vue preview",
    "release": "changeset publish",
    "release:snapshot": "pnpm build && pnpm changeset:snapshot",
    "syncpack": "pnpm syncpack:fix && pnpm syncpack:format",
    "syncpack:fix": "syncpack fix --dependency-types prod,dev",
    "syncpack:format": "syncpack format",
    "syncpack:lint": "syncpack lint --dependency-types prod,dev",
    "test": "vitest",
    "typedoc": "typedoc"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.6",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@eslint/js": "10.0.1",
    "@use-compose/logger": "0.0.6",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "happy-dom": "18.0.1",
    "husky": "9.1.7",
    "lint-staged": "16.3.0",
    "prettier": "3.5.3",
    "prettier-plugin-organize-imports": "4.1.0",
    "syncpack": "14.0.0-alpha.32",
    "typedoc": "0.28.10",
    "typedoc-plugin-markdown": "4.8.1",
    "typedoc-vitepress-theme": "1.1.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.4.1"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=9"
  },
  "keywords": [],
  "license": "MIT",
  "lint-staged": {
    "**/*.{js,ts,tsx}": [
      "eslint --fix"
    ],
    "**/*": "prettier --write --ignore-unknown"
  },
  "main": "index.js"
}
